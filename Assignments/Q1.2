#include<cmath>


double max(double arr[], int size);
double min(double arr[], int size);
double avg(double arr[], int size);


int main(){

    int a;
    std::cout << "enter no of reading" ;
    std::cin >> a ;
    double readings[100];
    std::cout<< "enter readings" << std::endl;
    for (int i=0;i<a;i++){
        
        std::cin >> readings[i];
    }
     for (int i=0;i<a;i++){
        if (readings[i]>=0){
            if (readings[i]>=45){
                std::cout << "first criticalreading is at :" << readings[i] << "found at " << i << std::endl;
                break;
            }
        }
        else{
            continue;
        }
            
            
     }
     std::cout << "max element is :" << max(readings,a) <<std::endl;
