     std::cout << "avg element is :" << avg(readings,a) <<std::endl;
     int normal=0;
     int warning =0;
     int critical = 0;
     int shutdown = 0;

     for (int i=0;i<a;i++){
        if (readings[i]>0 && readings[i]<=29){
            normal +=1;
