double max(double arr[], int size){
    double max= 0;
    for (int i=0;i<size;i++){
       
        if (arr[i]>max){
            max=arr[i];
        }
    }
    return max;
}
double min(double arr[], int size){
    int min= 0;
     
    for (int i=0;i<size;i++){
        if (arr[i]< 0){
            continue;
        }
        if (min>arr[i]){
            min=arr[i];
        }
    }
    return min;
}
double avg(double arr[], int size){
    double sum=0;
    int b = 0;
    for (int i=0;i<size;i++)
    {
        if (arr[i]>0){
            sum+=arr[i];
            b++;
        }
        else{
            continue;
        }
    }
    return sum/b;
}
